resource app_signature "application/x-vnd.sen-labs.sen-server";

resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	 major = 1,
	 middle = 0,
	 minor = 0,
	 variety = B_APPV_DEVELOPMENT,
	 internal = 0,
	 short_info = "SEN Server",
	 long_info = "Semantic Extensions Native server process providing an infrastructure for semantic relations and queries."
};

/* the picture of the About window (the logo of sen-core), a PNG that the translators of the system turn into a bitmap */
resource(100, "about-logo") #'bits' import "about-logo.png";

