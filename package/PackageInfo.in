name			sen_core
version			@VERSION@
architecture	@ARCH@
summary			"The core of SEN, the semantic desktop for Haiku"
description		"SEN (Semantic Extensions Native) adds relations between files to Haiku: the
SEN server keeps them in the attributes of the files, answers queries for them
and puts an item with a menu into the Deskbar (contexts, classifications, an
overview of what SEN knows, and a check for inconsistencies). The command sen
shows the same on the command line. Brings the core ontology with it; needs the plugins of
SENSEI to read relations from documents, and Akita (the file manager with SEN
integration) to work with relations on the desktop."
packager		"Gregor B. Rosenauer <semantic.extensions@gmail.com>"
vendor			"SEN Labs e.U."
copyrights		{
	"2020-2026 SEN Labs e.U."
}
licenses		{
	"MIT"
}
urls			{
	"https://sen-labs.org"
	"https://github.com/sen-laboratories/sen-core"
}
provides		{
	sen_core = @VERSION@
	cmd:sen_server = @VERSION@
	cmd:sen = @VERSION@
}
requires		{
	haiku
	lib:libspdlog
	lib:libfmt
	cmd:sen_oni
	sen_ontology_core
	sen_filetypes
}
